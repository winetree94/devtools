{
  "name": "@winetree94/devtools",
  "version": "1.1.0",
  "description": "A personal CLI tool for web search, page extraction, and development-agent workflows.",
  "type": "module",
  "license": "MIT",
  "author": "winetree94",
  "repository": {
    "type": "git",
    "url": "https://github.com/winetree94/devtools"
  },
  "keywords": [
    "cli",
    "web-search",
    "web-scraping",
    "agent",
    "devtools"
  ],
  "imports": {
    "#app/*.js": "./dist/*.js"
  },
  "bin": {
    "devtools": "./bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "sea:bundle": "node scripts/build-sea.mjs --bundle-only",
    "sea:build": "node scripts/build-sea.mjs",
    "sea:smoke": "node scripts/smoke-sea.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && biome check . && npm run test",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@stricli/core": "^1.2.6",
    "dotenv": "^17.3.1",
    "jsdom": "^29.0.0",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.0",
    "execa": "^9.6.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.1",
    "vitest": "^4.1.0"
  }
}
